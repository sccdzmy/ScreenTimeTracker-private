<Window x:Class="ScreenTimeTracker.Native.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="UsageTrack" Width="960" Height="700" MinWidth="760" MinHeight="560" WindowStartupLocation="CenterScreen">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="172"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Margin="12"><TextBlock DockPanel.Dock="Top" Text="UsageTrack" FontSize="22" FontWeight="SemiBold" Margin="8,12,0,24"/><TextBlock x:Name="TrayHint" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="8,12" FontSize="12"/><ListBox x:Name="Navigation" BorderThickness="0" SelectionChanged="Navigate"/></DockPanel>
  <DockPanel Grid.Column="1"><TextBlock x:Name="PageTitle" DockPanel.Dock="Top" FontSize="24" FontWeight="SemiBold" Margin="24,18,24,0"/><ContentControl x:Name="PageContent"/></DockPanel>
 </Grid>
</Window>
