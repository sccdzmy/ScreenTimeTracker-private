<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <SolidColorBrush x:Key="AppBackground" Color="#FAFAFA"/>
 <SolidColorBrush x:Key="AppForeground" Color="#202020"/>
 <SolidColorBrush x:Key="AppSurface" Color="#FFFFFF"/>
 <SolidColorBrush x:Key="AppSurfaceAlt" Color="#F3F3F3"/>
 <SolidColorBrush x:Key="AppSecondary" Color="#666666"/>
 <SolidColorBrush x:Key="AppCardBorder" Color="#E5E5E5"/>
 <SolidColorBrush x:Key="ChartGrid" Color="#DDDDDD"/>
 <SolidColorBrush x:Key="ChartMuted" Color="#9B9B9B"/>
 <Style x:Key="StatisticsCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource AppCardBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="14"/></Style>
 <Thickness x:Key="PagePadding">24</Thickness>
 <CornerRadius x:Key="CardRadius">8</CornerRadius>
 <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI, Microsoft YaHei UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource AppForeground}"/><Setter Property="Background" Value="{DynamicResource AppBackground}"/></Style>
 <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="0,4,8,4"/><Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="32"/></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="MinHeight" Value="32"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="MinHeight" Value="32"/></Style>
 <Style TargetType="DatePicker" BasedOn="{StaticResource {x:Type DatePicker}}"><Setter Property="Margin" Value="0,4,8,8"/><Setter Property="MinHeight" Value="32"/></Style>
 <Style TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}"><Setter Property="AutoGenerateColumns" Value="False"/><Setter Property="CanUserAddRows" Value="False"/><Setter Property="IsReadOnly" Value="True"/><Setter Property="EnableRowVirtualization" Value="True"/><Setter Property="EnableColumnVirtualization" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="HeadersVisibility" Value="Column"/><Setter Property="GridLinesVisibility" Value="None"/></Style>
</ResourceDictionary>
