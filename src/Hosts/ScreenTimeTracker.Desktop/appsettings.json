{
  "DatabaseOptions": {
    "DBFilePath": "./Data/ScreenTimeTracker.db"
  },
  "AllowedHosts": "127.0.0.1;localhost;[::1]",
  "Urls": "http://127.0.0.1:5124",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./Logs/log-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}